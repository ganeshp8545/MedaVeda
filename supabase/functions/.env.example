# LOCAL DEV ONLY — copy to .env for `supabase functions serve --env-file supabase/functions/.env`
# Never commit the real .env file. Production secrets must be set via:
#   supabase secrets set RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
#   supabase secrets set RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Verify what's actually deployed with: supabase secrets list
RAZORPAY_KEY_ID=rzp_test_your_test_key_here
RAZORPAY_KEY_SECRET=your_test_secret_here

# Required whenever RAZORPAY_KEY_ID starts with rzp_test_ (staging only).
# Without this, verify-payment/pay will refuse to run at all with a test
# key - this is intentional, so a test key can never silently end up
# processing real student payments in production again.
ALLOW_TEST_MODE=true

# This is the *Webhook Secret* configured on the Razorpay Dashboard webhook,
# not RAZORPAY_KEY_SECRET. Use a distinct, high-entropy value.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional and temporary: retain only while Razorpay may retry deliveries
# signed before a Dashboard webhook-secret rotation.
# RAZORPAY_WEBHOOK_PREVIOUS_SECRET=old_webhook_secret_here

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase when deployed. For `supabase functions serve --env-file`, set them here:
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
