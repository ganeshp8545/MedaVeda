rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// This file lives at the project root (same level as firebase.json and
// the functions/ folder) - see firebase.json's "firestore.rules" pointer.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Mirrors the admin panel's own check (context/AuthContext.tsx):
    // a uid is an admin if - and only if - admins/{uid} exists.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- Catalog: years / subjects / chapters / videos / notes / mcqs ----
    // Public within the app (any signed-in student can browse), but only
    // an admin can create/edit/delete - matches the admin panel being the
    // only place these are written from.
    match /years/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /subjects/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /chapters/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /videos/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /notes/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /mcqs/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Products (Store catalog) ----
    match /products/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Orders / Payments / Purchases ----
    // These are the access-control-critical ones: a student may only ever
    // READ their own records. Nothing writes them directly - the pay/
    // verifyPayment Cloud Functions use the Admin SDK, which bypasses
    // these rules entirely. If client writes were allowed here, anyone
    // could grant themselves free access by writing a purchase doc
    // directly, which is exactly what server-side signature verification
    // in verifyPayment.ts is there to prevent.
    match /orders/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin(); // status changes from the admin Orders page
    }
    match /purchases/{docId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }
    match /payments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Users (student profiles) ----
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ---- Admins allowlist ----
    // A user may check whether THEY are an admin (needed for the admin
    // panel's own login check), but never list/write this collection from
    // a client. Grant admin access by adding a doc via the Firebase
    // Console or Admin SDK, not from either app.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ---- Notifications ----
    match /notifications/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Bookmarks / Learning progress (per SRS Part 5) ----
    match /bookmarks/{docId} {
      allow read, write: if isOwner(resource.data.userId)
        || (isOwner(request.resource.data.userId) && resource == null);
    }
    match /userProgress/{docId} {
      allow read, write: if isOwner(resource.data.userId)
        || (isOwner(request.resource.data.userId) && resource == null);
    }

    // Default deny - anything not explicitly matched above is blocked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
